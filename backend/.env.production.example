# À copier en backend/.env sur le VPS, puis à remplir (ce fichier n'est jamais envoyé sur GitHub)
NODE_ENV=production
PORT=4100
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=incom
DB_PASSWORD=REMPLACER-par-le-mot-de-passe-MySQL
DB_NAME=incom_crm
# Générer avec : openssl rand -hex 48
JWT_SECRET=REMPLACER
CORS_ORIGIN=https://VOTRE-DOMAINE.dz,https://www.VOTRE-DOMAINE.dz

# Notifications par e-mail (facultatif : sans SMTP_HOST, les notifications restent dans le CRM)
# Exemple Gmail / Google Workspace : SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, mot de passe d'application
SITE_URL=https://VOTRE-DOMAINE.dz
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="IN COMMUNICATION <notifications@VOTRE-DOMAINE.dz>"
# Rôles qui reçoivent aussi les notifications par e-mail
NOTIFY_EMAIL_ROLES=admin,client
